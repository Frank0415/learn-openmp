{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lab 4: build (-O0)",
      "type": "shell",
      "command": "make -B all",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Lab 4: clean",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
